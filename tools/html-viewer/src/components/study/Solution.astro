---
import { t } from "@/lib/i18n";
interface Props {
  /** Summary text; default: localized "Show solution". */
  title?: string;
}
const { title } = Astro.props;
---

<details class="group not-prose my-6 rounded-lg border bg-card">
  <summary class="cursor-pointer list-none px-4 py-3 text-sm font-medium select-none hover:bg-accent">
    <span class="mr-2 inline-block transition-transform group-open:rotate-90">▸</span>{title ?? t(Astro.locals.lang, "showSolution")}
  </summary>
  <div class="prose max-w-none border-t px-4 py-3 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0"><slot /></div>
</details>
