---
import { t } from "@/lib/i18n";
const lang = Astro.locals.lang;
---

<div class="study-steps my-6" data-steps>
  <ol class="space-y-4 border-l-2 border-border pl-6"><slot /></ol>
  <div class="no-print mt-4 flex gap-2">
    <button type="button" data-next class="rounded-md bg-primary px-3 py-1.5 text-sm text-primary-foreground hover:opacity-90"
      >{t(lang, "nextStep")}</button
    >
    <button type="button" data-all class="rounded-md border px-3 py-1.5 text-sm text-muted-foreground hover:bg-accent"
      >{t(lang, "showAll")}</button
    >
  </div>
</div>

<script>
  // Progressive reveal: only the first <Step> is visible, buttons reveal the next ones.
  document.querySelectorAll<HTMLElement>("[data-steps]").forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const buttons = root.querySelector<HTMLElement>(".no-print")!;
    let shown = 1;
    const update = () => {
      steps.forEach((s, i) => (s.hidden = i >= shown));
      if (shown >= steps.length) buttons.hidden = true;
    };
    root.querySelector("[data-next]")?.addEventListener("click", () => {
      shown++;
      update();
    });
    root.querySelector("[data-all]")?.addEventListener("click", () => {
      shown = steps.length;
      update();
    });
    update();
  });
</script>
