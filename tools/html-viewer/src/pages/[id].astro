---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { components } from "@/components/study";
import { t } from "@/lib/i18n";
import { parseSource } from "@/lib/sources";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, date, language, tags, sources } = entry.data;
Astro.locals.lang = language;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={description} lang={language}>
  <article>
    <header class="mb-10">
      <h1 class="text-4xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 text-lg text-muted-foreground">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
        <time>{date.toISOString().slice(0, 10)}</time>
        {tags.map((tag) => <Badge variant="secondary">{tag}</Badge>)}
      </div>
    </header>

    <div class="prose max-w-none prose-headings:tracking-tight">
      <Content components={components} />
    </div>

    {
      sources.length > 0 && (
        <footer class="mt-12 border-t pt-6 text-sm">
          <h2 class="mb-2 font-medium">{t(language, "sources")}</h2>
          <ul class="list-disc space-y-1 pl-5 text-muted-foreground">
            {sources.map((ref) => {
              const { label, href } = parseSource(ref);
              return <li>{href ? <a class="text-primary hover:underline" href={href} target="_blank">{label}</a> : label}</li>;
            })}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>
