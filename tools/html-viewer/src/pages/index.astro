---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { t } from "@/lib/i18n";

// Home: every studio page, newest first (examples are reachable by URL only).
const pages = (await getCollection("pages"))
  .filter((p) => p.filePath?.startsWith("studio/"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id));
const lang = pages[0]?.data.language ?? "en";
---

<BaseLayout title="Study Lab" lang={lang}>
  <h1 class="mb-8 text-3xl font-semibold tracking-tight">Study Lab</h1>
  {pages.length === 0 && <p class="text-muted-foreground">{t(lang, "noPages")}</p>}
  <ul class="grid gap-3">
    {
      pages.map((p) => (
        <li>
          <a href={`/${p.id}`} class="block rounded-xl border bg-card p-4 transition-colors hover:border-primary">
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-medium">{p.data.title}</span>
              <time class="shrink-0 text-xs text-muted-foreground">{p.data.date.toISOString().slice(0, 10)}</time>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-1.5">
                {p.data.tags.map((tag) => (
                  <Badge variant="secondary">{tag}</Badge>
                ))}
              </div>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
